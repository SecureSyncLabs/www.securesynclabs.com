---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import Skills from '../components/Skills.astro';
---

<BaseLayout
	title="SecureSync Labs | Cyber security consulting"
	description="UK cyber security consultancy led by practitioners with more than a decade of experience. Penetration testing, cloud security, incident response, and attack surface management."
>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<Hero
					title="SecureSync Labs"
					tagline="Hands-on cyber security consulting from someone who has led the work inside organisations, not just written about it."
					align="start"
				>
					<div class="roles">
						<Pill><Icon icon="person" size="1.33em" /> Security consulting</Pill>
						<Pill><Icon icon="strategy" size="1.33em" /> Attack surface management</Pill>
						<Pill><Icon icon="code" size="1.33em" /> Cloud and engineering</Pill>
					</div>
					<div class="hero-actions">
						<CallToAction href="/about/charlie-dean/">
							Meet Charlie
							<Icon icon="arrow-right" size="1.2em" />
						</CallToAction>
					</div>
				</Hero>
			</header>

			<Skills />
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
			<section class="section with-background">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Experience you can put to work</h3>
					<p>
						SecureSync Labs is led by Charlie Dean, a practitioner with more than ten years across
						consulting and in-house security leadership. The work is practical: assessments, advice,
						and embedding with the teams who have to fix what we find.
					</p>
				</header>

				<ul class="capability-grid">
					<li class="capability-card">
						<h4>In-house security leadership</h4>
						<p>
							Several years leading security inside a UK financial services organisation — cloud
							security, product security, incident response, and managing a team.
						</p>
					</li>
					<li class="capability-card">
						<h4>Independent consulting</h4>
						<p>
							Penetration testing, vulnerability assessment, and security advice across financial
							services, legal, energy, education, and government.
						</p>
					</li>
					<li class="capability-card">
						<h4>Attack surface management</h4>
						<p>
							Helping organisations understand what they actually own, where the risk sits, and how
							existing controls change that picture — not a scan of the public internet and a hope
							that nothing was missed.
						</p>
					</li>
				</ul>
			</section>

			<section class="section with-background bg-variant">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>How we work</h3>
					<p>
						SecureSync Labs was founded in 2023. It is deliberately small: you work with someone who
						has done the job, led teams, and stayed close to the delivery.
					</p>
				</header>

				<ul class="mention-grid">
					{
						[
							{
								title: 'Hands-on',
								body: 'Assessments, architecture, and engineering — not slideware.',
							},
							{
								title: 'Embedded',
								body: 'We work with delivery teams, not around them.',
							},
							{
								title: 'Clear findings',
								body: 'Risk explained in plain language, with a path to fix it.',
							},
							{
								title: 'UK-based',
								body: 'A small consultancy that can move quickly without the overhead of a large firm.',
							},
						].map((item) => (
							<li class="mention-card">
								<p class="mention-title">{item.title}</p>
								<p>{item.body}</p>
							</li>
						))
					}
				</ul>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: center;
	}

	.hero-actions {
		margin-top: 1rem;
		display: flex;
		justify-content: center;
	}

	@media (min-width: 50em) {
		.hero {
			padding-inline: 2.5rem;
		}

		.roles,
		.hero-actions {
			justify-content: flex-start;
		}

		.roles {
			margin-top: 0.5rem;
		}
	}

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.with-background.bg-variant::before {
		--hero-bg: var(--bg-image-subtle-1);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 58ch;
		font-size: var(--text-md);
		color: var(--gray-300);
		line-height: 1.5;
	}

	.section-header h3 {
		font-size: var(--text-2xl);
		color: var(--gray-0);
		line-height: 1.15;
	}

	.capability-grid,
	.mention-grid {
		display: grid;
		gap: 1.25rem;
		padding: 0;
		list-style: none;
	}

	.capability-card,
	.mention-card {
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		padding: 1.75rem;
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
		color: var(--gray-300);
		line-height: 1.5;
	}

	.capability-card h4,
	.mention-title {
		margin: 0 0 0.75rem;
		color: var(--gray-0);
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		line-height: 1.25;
	}

	@media (min-width: 50em) {
		.section {
			gap: 3rem;
		}

		.section-header {
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.capability-grid,
		.mention-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.75rem;
		}

		.capability-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.capability-card,
		.mention-card {
			padding: 2.25rem;
		}
	}

	@media (max-width: 70em) {
		.capability-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
