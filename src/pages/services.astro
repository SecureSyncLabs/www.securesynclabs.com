---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';

const consulting = [
	{
		title: 'Penetration testing',
		body: 'Web applications, web services, infrastructure, and red team exercises designed to test whether controls actually work.',
	},
	{
		title: 'Attack surface management',
		body: 'A clear view of what you own and where the risk sits — using the data you already have, not only what can be seen from the public internet. When you need more than a review, we also build software to keep that picture current.',
	},
	{
		title: 'Cloud security',
		body: 'Architecture, configuration, and tooling across Azure and AWS — including rolling out standards that teams can actually follow.',
	},
	{
		title: 'Secure software delivery',
		body: 'SecDevOps, secure SDLC pipelines, static analysis, and source code review so applications are built securely rather than tested at the end.',
	},
	{
		title: 'Incident response',
		body: 'Investigation, triage, and working alongside in-house teams when something has already gone wrong.',
	},
	{
		title: 'Threat intelligence and architecture',
		body: 'Network design, threat intelligence, and practical advice on IT and security projects.',
	},
];

const software = [
	{
		title: 'Custom integrations',
		body: 'We connect to the security tools you already have so that data can be used to judge risk on assets. That might mean internal vulnerability scanning to understand exposure, or Akamai and Cloudflare to see whether a WAF is in place that could mitigate a finding. The work is custom — if you run it, we can integrate with it.',
	},
	{
		title: 'Attack surface software',
		body: 'Software built around an inside-out view of the estate: DNS, IP, and cloud inventory, combined with the tools you already operate, so you are not guessing at what you own.',
	},
	{
		title: 'Scanning at scale',
		body: 'When the estate is large, we can add scanning that scales in the cloud so tens of thousands of applications can be assessed in a short window.',
	},
	{
		title: 'Security automation',
		body: 'Replacing manual processes with reliable tooling so security teams spend less time copying data between systems.',
	},
];
---

<BaseLayout
	title="Services | SecureSync Labs"
	description="Cyber security consulting and attack surface management from SecureSync Labs. Custom software and integrations where they help."
>
	<div class="stack gap-20">
		<main class="wrapper services stack gap-20">
			<Hero
				title="Services"
				tagline="Consulting first. Custom software when a report is not enough — built around the tools you already have."
				align="start"
			/>

			<section class="stack gap-8">
				<div class="section-heading">
					<Icon icon="person" color="var(--accent-regular)" size="2rem" gradient />
					<h2>Cyber security consulting</h2>
				</div>
				<p class="lede">
					Assessments and advice across offensive testing, cloud, attack surface, secure
					development, and response. We write reports that non-specialists can act on, and we stay
					close to the teams doing the work.
				</p>
				<ul class="service-grid">
					{
						consulting.map((item) => (
							<li>
								<h3>{item.title}</h3>
								<p>{item.body}</p>
							</li>
						))
					}
				</ul>
			</section>

			<section class="stack gap-8">
				<div class="section-heading">
					<Icon icon="code" color="var(--accent-regular)" size="2rem" gradient />
					<h2>Software for clients</h2>
				</div>
				<p class="lede">
					We build security software for clients when off-the-shelf tools leave gaps. It is designed
					around the tooling you already run, with custom integrations so existing data can be used
					to understand risk.
				</p>
				<ul class="service-grid">
					{
						software.map((item) => (
							<li>
								<h3>{item.title}</h3>
								<p>{item.body}</p>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.services {
		padding-block: 0.5rem;
		padding-inline: 1.5rem;
	}

	@media (min-width: 50em) {
		.services {
			padding-inline: 2.5rem;
		}
	}

	.section-heading {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
	}

	.section-heading h2 {
		font-size: var(--text-2xl);
		line-height: 1.2;
		color: var(--gray-0);
	}

	.lede {
		max-width: 70ch;
		color: var(--gray-300);
		font-size: var(--text-md);
		line-height: 1.6;
	}

	.service-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		padding: 0;
		list-style: none;
	}

	.service-grid li {
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		padding: 1.75rem 1.75rem 2rem;
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
		min-height: 11rem;
	}

	.service-grid h3 {
		margin: 0 0 0.85rem;
		font-size: var(--text-xl);
		line-height: 1.3;
		color: var(--gray-0);
	}

	.service-grid p {
		color: var(--gray-300);
		font-size: var(--text-md);
		line-height: 1.6;
	}

	@media (min-width: 50em) {
		.section-heading {
			align-items: center;
		}

		.section-heading h2 {
			font-size: var(--text-3xl);
		}

		.lede {
			font-size: var(--text-lg);
		}
	}

	@media (min-width: 72em) {
		.service-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 2rem;
		}

		.service-grid li {
			padding: 2.25rem 2.5rem 2.5rem;
		}
	}
</style>
