---
import Icon from './Icon.astro';
---

<section class="box skills">
	<div class="stack gap-2 lg:gap-4">
		<Icon icon="person" color="var(--accent-regular)" size="2.5rem" gradient />
		<h2>Security consulting</h2>
		<p>
			Penetration testing, cloud security, incident response, and secure delivery advice for teams
			that need a practitioner, not a slide deck.
		</p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<Icon icon="code" color="var(--accent-regular)" size="2.5rem" gradient />
		<h2>Security software</h2>
		<p>
			Custom tooling, automation, and secure development across Python, Java, PowerShell, C#, and
			JavaScript — including work with large data sets.
		</p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<Icon icon="terminal-window" color="var(--accent-regular)" size="2.5rem" gradient />
		<h2>Attack surface management</h2>
		<p>
			An inside-out view of the estate: DNS, IP, and cloud inventory, enriched with external
			telemetry and scanned at scale.
		</p>
	</div>
</section>

<style>
	.box {
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		padding: 1.5rem;
		background-color: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
	}

	.skills {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.skills h2 {
		font-size: var(--text-lg);
	}

	.skills p {
		color: var(--gray-400);
	}

	@media (min-width: 50em) {
		.box {
			border-radius: 1.5rem;
			padding: 2.5rem;
		}

		.skills {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 3rem;
		}

		.skills h2 {
			font-size: var(--text-2xl);
		}
	}
</style>
